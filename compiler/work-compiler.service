[Unit]
Description=Work private TeX Live 2025 compiler
After=network.target

[Service]
Type=simple
User=work-compiler
StateDirectory=work-compiler
EnvironmentFile=/etc/work-compiler.env
Environment=WORK_COMPILER_TMPDIR=/var/lib/work-compiler
Environment=WORK_TEXLIVE_ROOT=/opt/work-texlive/2025
ExecStart=/opt/work-compiler/node /opt/work-compiler/server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=full
MemoryMax=1536M
TasksMax=128
UMask=0077

[Install]
WantedBy=multi-user.target
